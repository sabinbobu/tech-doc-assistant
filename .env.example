# ── API Keys ──
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Get your Anthropic key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Get your OpenRouter key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ── LLM Settings ──
# LLM_PROVIDER: "openai", "anthropic", or "openrouter". OpenRouter proxies many
# providers (including several free-tier models, e.g. "deepseek/deepseek-chat-v3.1:free")
# behind one OpenAI-compatible API -- see https://openrouter.ai/models. When using
# openrouter, LLM_MODEL must be an OpenRouter model slug, not a plain model name.
#
# If you're on the openrouter provider, prefer LLM_MODEL="openrouter/free" over
# pinning one ":free" model directly. A single free-tier model (this project
# hit this with "z-ai/glm-5.2:free") gets upstream-429-rate-limited under
# nothing more than a 30-question eval run. "openrouter/free" randomly
# distributes each call across ~24 free models instead of hammering one --
# verified this session: 15/15 sequential calls succeeded (0 errors) across 8
# different models, where the single pinned model had been failing. Tradeoff,
# not free: model identity now varies per call, so answer phrasing/quality is
# no longer deterministic across runs even at temperature=0, and the pool
# includes a few non-general-purpose models (e.g. a content-safety classifier,
# a code-specialized model) alongside general chat models. Fine for
# interactive/dev use; if you need reproducible eval runs, pin LLM_PROVIDER to
# openai/anthropic for that run instead (see evaluation/evaluate.py usage in
# CLAUDE.md-equivalent project history for how this was done).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ── Chunking ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ──
RETRIEVAL_TOP_K=8

# How many candidates hybrid search fetches before reranking narrows to
# RETRIEVAL_TOP_K. Must be >= RETRIEVAL_TOP_K.
RETRIEVAL_CANDIDATE_K=20

# Cross-encoder reranking (src/retrieval/rerank.py) — local model, no API
# key, one-time download on first use.
RERANKING_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Query rewriting (src/retrieval/query_rewrite.py) — defaults OFF. Measured
# to regress answer faithfulness on this project's own eval; see the
# comment on query_rewrite_enabled in src/config.py before turning it on.
QUERY_REWRITE_ENABLED=false
# REWRITE_MODEL=gpt-4o-mini    # unset = reuse LLM_MODEL

# ── Observability (Opik) ──
# Credentials live in ~/.opik.config (written by `opik configure`), NOT here —
# one config mechanism per project, and that file is already the source of
# truth for the workspace and API key. Nothing to set below to make tracing
# work; the variable exists only to turn it OFF.
#
# Set to true to make every @opik.track in src/ a pass-through: no spans, no
# network calls, no API key needed. CI sets this (.github/workflows/ci.yml)
# and so does the test suite (tests/conftest.py), because mocked-LLM runs
# would otherwise bury the real traces in the Tech-Doc-Assistant project.
# OPIK_TRACK_DISABLE=true
