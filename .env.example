# ── API Keys ──
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Get your Anthropic key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ── LLM Settings ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ── Chunking ──
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ──
RETRIEVAL_TOP_K=8

# How many candidates hybrid search fetches before reranking narrows to
# RETRIEVAL_TOP_K. Must be >= RETRIEVAL_TOP_K.
RETRIEVAL_CANDIDATE_K=20

# Cross-encoder reranking (src/retrieval/rerank.py) — local model, no API
# key, one-time download on first use.
RERANKING_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Query rewriting (src/retrieval/query_rewrite.py) — defaults OFF. Measured
# to regress answer faithfulness on this project's own eval; see the
# comment on query_rewrite_enabled in src/config.py before turning it on.
QUERY_REWRITE_ENABLED=false
# REWRITE_MODEL=gpt-4o-mini    # unset = reuse LLM_MODEL
